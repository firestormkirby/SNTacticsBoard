{
  "name": "tacticsboard",
  "version": "0.9.0",
  "private": true,
  "description": "Coach's whiteboard for Supernote notes: draw with the pen, and drag players, cones and balls onto the page from a floating button, and save layouts to load later.",
  "scripts": {
    "build:plugin": "node scripts/build-plugin.js",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployPlugin.ps1",
    "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/runPlugin.ps1",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logs.ps1",
    "deploy:run": "npm run deploy && npm run run",
    "preview": "npm --prefix tools/ui-preview run dev",
    "preview:install": "npm --prefix tools/ui-preview install",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "start": "react-native start"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-view-shot": "4.0.3",
    "sn-plugin-lib": "^0.1.65"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
