{
  // Vendored copy inside the plugin repo. Unlike a standalone checkout, the
  // plugin's own node_modules sits two levels up, so the type-check resolves
  // react-native, sn-plugin-lib and friends to their REAL type definitions
  // rather than to the browser mocks. The plugin source is then checked here
  // exactly as it is by `npm run typecheck` at the repo root. Vite still swaps
  // in the mocks at runtime; see vite.config.ts.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "preview.config.tsx", "vite.config.ts"]
}
